# SECURITY (S1): local MCP server configs may embed live API keys (e.g.
# .roo/mcp.json). Never commit them.
.roo/
.roo/mcp.json

# Python cache & notebook artifacts
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Local editor & system files
*.kate-swp
.DS_Store

# Heavy deep learning weights (prevents GitHub 100MB reject)
*.ckpt
*.pt
*.bin

# Datasets and tabular outputs
*.csv
*.parquet
*.db
